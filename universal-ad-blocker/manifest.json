{
  "manifest_version": 3,
  "name": "Universal Ad Blocker",
  "version": "1.1.0",
  "description": "Blocks common advertising networks and removes visible ads from non-YouTube webpages.",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "common-ad-rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
