{
  "manifest_version": 3,
  "name": "LiquidGlass",
  "version": "1.0.0",
  "description": "Applies an iOS-style frosted glassmorphism theme to websites.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LiquidGlass"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
