{
  "manifest_version": 3,
  "name": "LiquidGlass",
  "version": "1.0.0",
  "description": "Applies a local iOS-style frosted glassmorphism theme to GitHub.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["*://github.com/*", "*://www.github.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LiquidGlass"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
