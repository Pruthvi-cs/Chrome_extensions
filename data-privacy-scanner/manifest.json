{
  "manifest_version": 3,
  "name": "Website Data Privacy Scanner",
  "version": "1.0.0",
  "description": "Shows which third-party services, trackers, storage methods, and browser data signals a website may use.",
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "webRequest",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Data Privacy Scanner"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
