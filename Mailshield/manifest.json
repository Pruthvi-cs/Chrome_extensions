{
  "manifest_version": 3,
  "name": "Mailshield",
  "version": "1.0.0",
  "description": "Email threat detection and forensic intelligence.",
  "permissions": [],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mailshield"
  }
}