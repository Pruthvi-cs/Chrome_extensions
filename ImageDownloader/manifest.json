{
  "manifest_version": 3,
  "name": "ImageDownloader",
  "version": "1.0.0",
  "description": "Download images directly by hovering over them.",
  "permissions": ["downloads", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "ImageDownloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
