{
  "manifest_version": 3,
  "name": "YouTube Ad Blocker",
  "version": "2.0.0",
  "description": "Blocks common YouTube video and page advertisements.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googleadservices.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube-ad-rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
